{
  "schema_version": 1,
  "mixins": [
    "${mod_id}-quilt.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "quilt_loader": {
    "group": "${groupId}",
    "id": "${mod_id}",
    "version": "${mod_version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${mod_description}",
      "contributors": {
        "Me!": "${mod_authors}"
      },
      "contact": {
        "homepage": "${mod_displayURL}",
        "sources": "${mod_issueTrackerURL}"
      },
      "icon": "${mod_id}.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "com.craftjakob.gildednetherite.quilt.GildedNetheriteQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": ">=${minecraft_version}"
      },
      {
        "id": "architectury",
        "version": ">=${architectury_version}"
      },
      {
        "id": "configapi",
        "version": ">=${configapi_version}"
      }
    ]
  },
  "minecraft": {
    "environment": "*"
  }
}
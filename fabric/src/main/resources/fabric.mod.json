{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_displayURL}",
    "sources": "${mod_issueTrackerURL}"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.craftjakob.gildednetherite.fabric.GildedNetheriteFabric"
    ]
  },
  "mixins": [
    "${mod_id}-fabric.mixins.json",
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "architectury": ">=${architectury_version}",
    "configapi": ">=${configapi_version}"
  }
}
